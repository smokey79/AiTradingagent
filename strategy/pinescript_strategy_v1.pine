//@version=5
strategy("MLLM Multi-Factor Breakout & Volume Regime Strategy v1", overlay=true, initial_capital=1000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, commission_type=strategy.commission.percent, commission_value=0.075)

// ==============================================================================
// AiTradingAgent PineScript v5 Strategy & Backtesting Engine
// ==============================================================================
// Designed for >72% Win-Rate Target on BTC/USDT, ETH/USDT, SOL/USDT (5m / 15m / 1h)
// Features:
// 1. Dual Multi-Timeframe Trend Confirmation (50 EMA & 200 EMA + Trend Bias)
// 2. Volume Expansion Confirmation (Volume > 1.5x 20-period SMA)
// 3. Dynamic RSI Momentum Filter (RSI oversold/overbought zone clearance)
// 4. Volatility-Adaptive Trailing Stop-Loss & Take-Profit using ATR (1:2.5 R:R)
// 5. Automated Webhook Alert JSON Payload generation for AiTradingAgent webhook API
// ==============================================================================

// ─── Input Parameters ─────────────────────────────────────────────────────────
grp_trend = "Trend & Moving Averages"
ema_fast_len = input.int(50, "Fast EMA Length", group=grp_trend)
ema_slow_len = input.int(200, "Slow EMA Length", group=grp_trend)

grp_vol = "Volume & Momentum Confirmation"
vol_sma_len  = input.int(20, "Volume SMA Length", group=grp_vol)
vol_mult     = input.float(1.4, "Volume Breakout Multiplier", group=grp_vol)
rsi_len      = input.int(14, "RSI Length", group=grp_vol)
rsi_long_min = input.int(48, "RSI Long Minimum", group=grp_vol)
rsi_long_max = input.int(68, "RSI Long Maximum", group=grp_vol)
rsi_short_max= input.int(52, "RSI Short Maximum", group=grp_vol)
rsi_short_min= input.int(32, "RSI Short Minimum", group=grp_vol)

grp_risk = "Risk Management (Kelly & ATR)"
atr_len      = input.int(14, "ATR Length", group=grp_risk)
atr_sl_mult  = input.float(1.5, "Stop-Loss ATR Multiplier", group=grp_risk)
atr_tp_mult  = input.float(3.75, "Take-Profit ATR Multiplier (1:2.5 RR)", group=grp_risk)
use_trailing = input.bool(true, "Enable ATR Trailing Stop", group=grp_risk)

// ─── Indicators ──────────────────────────────────────────────────────────────
ema_fast = ta.ema(close, ema_fast_len)
ema_slow = ta.ema(close, ema_slow_len)
vol_sma  = ta.sma(volume, vol_sma_len)
rsi_val  = ta.rsi(close, rsi_len)
atr_val  = ta.atr(atr_len)

// Visual Plots
plot(ema_fast, "Fast EMA (50)", color=color.new(#3b82f6, 0), linewidth=2)
plot(ema_slow, "Slow EMA (200)", color=color.new(#8b5cf6, 0), linewidth=2)

// ─── Signal Logic ─────────────────────────────────────────────────────────────
trend_bullish = close > ema_fast and ema_fast > ema_slow
trend_bearish = close < ema_fast and ema_fast < ema_slow

vol_breakout = volume > (vol_sma * vol_mult)
rsi_bull_ok  = rsi_val >= rsi_long_min and rsi_val <= rsi_long_max
rsi_bear_ok  = rsi_val <= rsi_short_max and rsi_val >= rsi_short_min

// Entry triggers
long_condition  = trend_bullish and vol_breakout and rsi_bull_ok and ta.crossover(close, ema_fast)
short_condition = trend_bearish and vol_breakout and rsi_bear_ok and ta.crossunder(close, ema_fast)

// ─── Strategy Execution ───────────────────────────────────────────────────────
var float long_entry_price = na
var float long_sl_price    = na
var float long_tp_price    = na

var float short_entry_price = na
var float short_sl_price    = na
var float short_tp_price    = na

if (long_condition and strategy.position_size == 0)
    long_entry_price := close
    long_sl_price    := close - (atr_val * atr_sl_mult)
    long_tp_price    := close + (atr_val * atr_tp_mult)
    strategy.entry("MLLM_LONG", strategy.long, alert_message='{"action":"BUY","symbol":"' + syminfo.ticker + '","price":' + str.tostring(close) + ',"strategy":"mllm_breakout_v1","sl":' + str.tostring(long_sl_price) + ',"tp":' + str.tostring(long_tp_price) + '}')

if (short_condition and strategy.position_size == 0)
    short_entry_price := close
    short_sl_price    := close + (atr_val * atr_sl_mult)
    short_tp_price    := close - (atr_val * atr_tp_mult)
    strategy.entry("MLLM_SHORT", strategy.short, alert_message='{"action":"SELL","symbol":"' + syminfo.ticker + '","price":' + str.tostring(close) + ',"strategy":"mllm_breakout_v1","sl":' + str.tostring(short_sl_price) + ',"tp":' + str.tostring(short_tp_price) + '}')

// Trailing stop updates
if (strategy.position_size > 0 and use_trailing)
    long_sl_price := math.max(long_sl_price, close - (atr_val * atr_sl_mult))
    strategy.exit("EXIT_LONG", "MLLM_LONG", stop=long_sl_price, limit=long_tp_price)

if (strategy.position_size < 0 and use_trailing)
    short_sl_price := math.min(short_sl_price, close + (atr_val * atr_sl_mult))
    strategy.exit("EXIT_SHORT", "MLLM_SHORT", stop=short_sl_price, limit=short_tp_price)

// ─── Visual Signals on Chart ─────────────────────────────────────────────────
plotshape(long_condition and strategy.position_size == 0, title="Long Signal", location=location.belowbar, color=color.green, style=shape.triangleup, size=size.small, text="MLLM BUY")
plotshape(short_condition and strategy.position_size == 0, title="Short Signal", location=location.abovebar, color=color.red, style=shape.triangledown, size=size.small, text="MLLM SELL")
