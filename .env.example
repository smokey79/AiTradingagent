# AiTradingAgent Multi-LLM Environment Configuration
# Copy to .env and fill in your API keys
# WARNING: Never commit .env to version control

# ===== MULTI-LLM API KEYS =====
# Claude (Anthropic) - Recommended for complex financial analysis
ANTHROPIC_API_KEY=sk-ant-your_key_here

# OpenAI - GPT-4 for market analysis & strategy
OPENAI_API_KEY=sk-your_key_here

# Google Gemini - Cost-effective multimodal analysis
GEMINI_API_KEY=your_gemini_api_key_here

# Perplexity - Real-time web search for market news
PERPLEXITY_API_KEY=your_perplexity_key_here

# OpenRouter - Zero-cost Free Tier Pool (DeepSeek R1, Llama 3.3 70B, Qwen, Gemini Flash)
OPENROUTER_API_KEY=sk-or-your_key_here
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
OPENROUTER_FREE_MODEL=deepseek/deepseek-r1:free

# DeepSeek (Direct API or OpenRouter)
DEEPSEEK_API_KEY=your_deepseek_key_here
DEEPSEEK_MODEL=deepseek/deepseek-r1:free
PRIMARY_MODEL=deepseek/deepseek-r1:free
SECONDARY_MODEL=meta-llama/llama-3.3-70b-instruct:free
FALLBACK_MODEL=deepseek/deepseek-chat:free

# ===== MARKET DATA APIs =====
# CoinMarketCap (Pro API key)
CMC_API_KEY=your_cmc_api_key_here
COINMARKETCAP_API_KEY=your_cmc_api_key_here

# CoinGecko (free tier available or Pro key)
COINGECKO_API_KEY=your_coingecko_key_here

# ===== EXCHANGE CREDENTIALS =====
# Bitget Exchange (Spot & Futures)
BITGET_API_KEY=your_bitget_api_key_here
BITGET_SECRET=your_bitget_secret_here
BITGET_API_SECRET=your_bitget_secret_here
BITGET_API_PASSPHRASE=your_bitget_passphrase_here
BITGET_PASSPHRASE=your_bitget_passphrase_here
BITGET_SANDBOX=false
BITGET_TESTNET=false

# ===== TRADING CONFIGURATION =====
# Risk Management
MAX_POSITION_SIZE=10000          # Maximum USD per trade
MAX_PORTFOLIO_RISK=0.02          # 2% max portfolio risk per trade
STOP_LOSS_PERCENT=5              # Stop loss at 5%
TAKE_PROFIT_PERCENT=15           # Take profit at 15%

# ===== SERVER CONFIGURATION =====
NODE_ENV=production
PYTHONUNBUFFERED=1
HOST=0.0.0.0
DASHBOARD_PORT=3002
PORT=3002
WAITRESS_THREADS=8
DEBUG=false
