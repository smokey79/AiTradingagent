# ── Trading Parameters ────────────────────────────────────────────────────────
PAPER_TRADE_MODE=true                     # ALWAYS true until 500-trade test passes
TRADE_AMOUNT_USD=1000.0
MIN_NET_PROFIT_USD=1.50
MIN_WIN_RATE_THRESHOLD=0.68               # 68% — matches your accuracy target
MAX_DAILY_LOSS_USD=50.0
MAX_CONCURRENT_TRADES=3
PROFIT_SWEEP_THRESHOLD_USD=100.0         # Auto-sweep to Nexo when profit >= this

# ── Agent Learning ────────────────────────────────────────────────────────────
LEARNING_DB_PATH=data/agent_memory.db    # SQLite for local learning store
MIN_TRADES_BEFORE_ADAPT=50               # Don't adapt strategy until N trades logged
