# ==============================================================================
# AiTradingAgent — Environment Configuration Template
# ==============================================================================

# System Mode
NODE_ENV=development
PAPER_TRADING=true
DASHBOARD_PORT=3001
WS_PORT=3001

# Trading Universe & Limits
TRADING_PAIRS=BTC/USDT,ETH/USDT,SOL/USDT,CRO/USDT,AVAX/USDT,ARB/USDT,OP/USDT
INITIAL_DEPOSIT=250.00
MIN_CONFIDENCE=0.72
LEVERAGE_MAX=1.0

# Multi-Agent API Keys (Set keys to enable live LLM calls; otherwise mock simulator runs)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=

# Local Ollama Hermes Agent
OLLAMA_URL=http://localhost:11434/api/generate
HERMES_MODEL=hermes3

# Market Data API Keys (Optional - Free fallback tiers supported)
CMC_API_KEY=
COINGECKO_API_KEY=
GLASSNODE_API_KEY=

# Exchange Execution API Keys (Bitget / Crypto.com / Binance)
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=

CRYPTOCOM_API_KEY=
CRYPTOCOM_API_SECRET=

BINANCE_API_KEY=
BINANCE_API_SECRET=

# Profit Allocation Rules
PROFIT_REINVEST_PCT=0.40
PROFIT_BTC_PCT=0.50
PROFIT_LONGTERM_PCT=0.10
PROFIT_DOUBLE_TRIGGER=2.0

# Risk Gate Hard Limits
RISK_MAX_PORTFOLIO_EXPOSURE_PCT=40
RISK_MAX_SINGLE_POSITION_PCT=10
RISK_MAX_DAILY_DRAWDOWN_PCT=12
RISK_MAX_SESSION_LOSS_PCT=8
RISK_MIN_WIN_RATE_GATE=0.80
RISK_MIN_SAMPLE_SIZE=20
